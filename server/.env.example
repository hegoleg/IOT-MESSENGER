# Relay server configuration. Copy this file to .env and adjust the values.
# Never commit real tokens or keys.

# HTTP/WebSocket listening address
PORT=8080
HOST=0.0.0.0

# SQLite database path (relative paths are resolved from server/)
DB_PATH=./data/iot.db

# Message rate limit per WebSocket connection (packets of type msg/cb per minute)
RATE_LIMIT_PER_MIN=20

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional: when set, POST /api/v1/devices/create requires
# "Authorization: Bearer <ADMIN_KEY>"
# ADMIN_KEY=
