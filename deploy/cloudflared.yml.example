# Named Cloudflare Tunnel for a permanent relay address.
#
# 1. cloudflared tunnel login
# 2. cloudflared tunnel create iot-relay
# 3. cloudflared tunnel route dns iot-relay relay.example.com
# 4. Copy this file to ~/.cloudflared/config.yml and replace:
#      - REPLACE_TUNNEL_UUID   with the UUID printed by `tunnel create`
#      - relay.example.com     with your domain
# 5. cloudflared tunnel run iot-relay
#
# Or run it as a service:  sudo cloudflared service install

tunnel: REPLACE_TUNNEL_UUID
credentials-file: /home/pi/.cloudflared/REPLACE_TUNNEL_UUID.json

ingress:
  - hostname: relay.example.com
    service: http://localhost:8080
  - service: http_status:404
