#pragma once

// Copy this file to include/secrets.h and fill in real values.
// include/secrets.h is ignored by git — never commit real credentials.

// WiFi
#define WIFI_SSID "your-wifi"
#define WIFI_PASS "your-password"

// Device token issued by the relay:
//   curl -X POST https://your.server/api/v1/devices/create
#define BOT_TOKEN "REPLACE_WITH_DEVICE_TOKEN"

// Relay endpoint. secure=true -> wss:// (cloud), false -> ws:// (local server).
#define SERVER_HOST "your.server.example"
#define SERVER_PORT 443
#define SERVER_SECURE true
