#pragma once

// Copy this file to include/secrets.h and fill in real values.
// include/secrets.h is ignored by git — never commit real credentials.

// WiFi
#define WIFI_SSID "your-wifi"
#define WIFI_PASS "your-password"

// Shared secret for the local WebSocket server. The PWA connects to
// ws://<DEVICE_IP>:81/ws?token=<LAN_TOKEN>. Any long random string works:
// this token never goes to a server, it only protects the local socket.
#define LAN_TOKEN "REPLACE_WITH_LONG_RANDOM_STRING"

// Optional mDNS hostname. The board is reachable as <hostname>.local.
// Leave empty to use iotbot-<chip-id>.
#define LAN_HOSTNAME ""
